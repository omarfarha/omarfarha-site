---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const page = await getEntry('pages', 'coaching');
if (!page) throw new Error('Missing pages/coaching.md content entry');

const headingHtml = page.data.heading ? marked.parseInline(page.data.heading) : '';
const ledeHtml = page.data.lede ? marked.parseInline(page.data.lede) : '';
const focusAreas = page.data.focusAreas ?? [];
---

<Layout title="Coaching" active="coaching" defaultInterest="Coaching" description={page.data.metaDescription}>
  <header class="page-hero">
    <div class="wrap">
      <div class="eyebrow">{page.data.eyebrow}</div>
      <h1 set:html={headingHtml} />
      <p class="lede" set:html={ledeHtml} />
    </div>
  </header>

  <section class="focus">
    <div class="wrap">
      <div class="eyebrow" style="margin-top:0;">Areas of focus</div>
      <ul class="focus-list">
        {focusAreas.map((item, i) => (
          <li class="focus-item">
            <div class="num">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3>{item.title}</h3>
              <p set:html={marked.parseInline(item.description)} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {page.data.getStartedHeading && (
    <section class="cta-strip">
      <div class="wrap">
        <div class="box">
          <div class="eyebrow" style="margin-bottom:14px;">{page.data.getStartedHeading}</div>
          <p style="font-size:17px; color:var(--text-soft); max-width:64ch; font-weight:300;" set:html={marked.parseInline(page.data.getStartedText ?? '')} />
        </div>
      </div>
    </section>
  )}
</Layout>
