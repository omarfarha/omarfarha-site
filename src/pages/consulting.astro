---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';
import { marked } from 'marked';

const page = await getEntry('pages', 'consulting');
if (!page) throw new Error('Missing pages/consulting.md content entry');

const headingHtml = page.data.heading ? marked.parseInline(page.data.heading) : '';
const ledeHtml = page.data.lede ? marked.parseInline(page.data.lede) : '';
const focusAreas = page.data.focusAreas ?? [];

const work = (await getCollection('work', ({ data }) => data.visible)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Consulting" active="consulting" defaultInterest="Consulting for my organization" description={page.data.metaDescription}>
  <header class="page-hero">
    <div class="wrap">
      <div class="eyebrow">{page.data.eyebrow}</div>
      <h1 set:html={headingHtml} />
      <p class="lede" set:html={ledeHtml} />
    </div>
  </header>

  <section class="focus">
    <div class="wrap">
      <div class="eyebrow" style="margin-top:0;">Areas of focus</div>
      <ul class="focus-list">
        {focusAreas.map((item, i) => (
          <li class="focus-item">
            <div class="num">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3>{item.title}</h3>
              <p set:html={marked.parseInline(item.description)} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="work">
    <div class="wrap">
      <div class="eyebrow">Selected work</div>
      <p class="work-intro" set:html={marked.parseInline(page.data.workIntro ?? '')} />
      <div class="work-grid">
        {work.map((item) => (
          <div class="work-item">
            {item.data.image ? (
              <div class="media">
                <img src={item.data.image} alt={item.data.title} />
              </div>
            ) : (
              <div class="media placeholder">
                <div class="play">▶</div>
                <span class="label">Image / video</span>
              </div>
            )}
            <div class="cap">
              <div class="tag">{item.data.tag}</div>
              <h3>{item.data.title}</h3>
              <p>{item.data.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="wrap">
      <div class="box" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;">
        <h3 style="font-family:'Fraunces', serif; font-weight:440; font-size:26px; max-width:520px;">
          Have a project in mind? Let's talk about it.
        </h3>
        <a href="#contact" class="apply">Discuss a project →</a>
      </div>
    </div>
  </section>
</Layout>
